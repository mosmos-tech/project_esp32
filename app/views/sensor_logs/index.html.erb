<!DOCTYPE html>
<html>
<head>
  <title>IT Room Monitor</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f4f9; padding: 20px; }
    h1 { color: #333; text-align: center; }
    .container { width: 100%; max-width: 800px; margin: 0 auto; }
    .chart-box { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); margin-bottom: 30px; }
    table { width: 100%; border-collapse: collapse; background: #fff; box-shadow: 0 4px 8px rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden; }
    th, td { padding: 12px; border: 1px solid #ddd; text-align: center; }
    th { background-color: #2c3e50; color: white; }
    tr:nth-child(even) { background-color: #f2f2f2; }
  </style>
</head>
<body>

  <div class="container">
    <h1>Server Room Dashboard</h1>
    
    <div class="chart-box">
      <canvas id="sensorChart"></canvas>
    </div>

    <table>
      <thead>
        <tr>
          <th>เวลา (Time)</th>
          <th>อุณหภูมิ (°C)</th>
          <th>ความชื้น (%)</th>
        </tr>
      </thead>
      <!-- เปลี่ยนมาใส่ id ให้ JavaScript เข้ามาควบคุมตารางได้ -->
      <tbody id="logTableBody">
      </tbody>
    </table>
  </div>

  <script>
    const ctx = document.getElementById('sensorChart').getContext('2d');
    const sensorChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: [], 
        datasets: [
          {
            label: 'Temperature (°C)',
            borderColor: '#e74c3c',
            backgroundColor: 'rgba(231, 76, 60, 0.2)',
            data: [],
            borderWidth: 2,
            tension: 0.3,
            fill: true
          },
          {
            label: 'Humidity (%)',
            borderColor: '#3498db',
            backgroundColor: 'rgba(52, 152, 219, 0.2)',
            data: [],
            borderWidth: 2,
            tension: 0.3,
            fill: true
          }
        ]
      },
      options: {
        responsive: true,
        scales: { y: { beginAtZero: false } }
      }
    });

    async function updateChart() {
      try {
        const response = await fetch('/sensor_logs.json');
        const logs = await response.json();
        
        // 1. อัปเดตกราฟ (เหมือนเดิม)
        const labels = logs.map(log => new Date(log.created_at).toLocaleTimeString('th-TH'));
        const temps = logs.map(log => log.temperature);
        const hums = logs.map(log => log.humidity);
        
        sensorChart.data.labels = labels;
        sensorChart.data.datasets[0].data = temps;
        sensorChart.data.datasets[1].data = hums;
        sensorChart.update();

        // 2. อัปเดตตารางแบบ Real-time (โค้ดส่วนที่เพิ่มเข้ามา)
        const tableBody = document.getElementById('logTableBody');
        let tableHTML = '';
        
        // สลับเอาข้อมูลใหม่ล่าสุดขึ้นบนสุด (reverse) แล้วสร้าง HTML แถวตาราง
        [...logs].reverse().forEach(log => {
          const time = new Date(log.created_at).toLocaleString('th-TH');
          tableHTML += `<tr>
            <td>${time}</td>
            <td>${log.temperature}</td>
            <td>${log.humidity}</td>
          </tr>`;
        });
        
        // ยัด HTML ใหม่เข้าไปในตาราง
        tableBody.innerHTML = tableHTML;
        
      } catch (error) {
        console.error('Error fetching data:', error);
      }
    }

    updateChart();
    setInterval(updateChart, 5000); // วนลูปดึงข้อมูลใหม่ทุก 4 วินาที
  </script>

</body>
</html>